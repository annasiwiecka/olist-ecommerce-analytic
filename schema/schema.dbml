Table clean.customers {
  customer_id varchar [primary key, not null]
  customer_unique_id varchar [not null]
  customer_zip_code_prefix integer
  customer_city varchar
  customer_state varchar
}

Table clean.geolocation {
  id integer [increment, primary key]
  geolocation_zip_code_prefix integer [not null]
  geolocation_lat "double precision"   
  geolocation_lng "double precision"  
  geolocation_city varchar
  geolocation_state varchar

  Note: 'Joined to customers and sellers by zip code prefix. Not a foreign key: zip codes repeat in this table.'
}

Table clean.order_items {
  order_id varchar [not null]
  order_item_id integer [not null]
  product_id varchar [not null]
  seller_id varchar [not null]
  shipping_limit_date timestamp
  price numeric(10,2) [not null]          
  freight_value numeric(10,2) [not null]  

  indexes {
    (order_id, order_item_id) [pk]
  }
}

Table clean.order_payments {
  order_id varchar [not null]
  payment_sequential integer [not null]
  payment_type varchar [not null]
  payment_installments integer
  payment_value numeric(10,2) [not null]  

  indexes {
    (order_id, payment_sequential) [pk]
  }
}

Table clean.order_reviews {
  review_id varchar [not null]
  order_id varchar [not null]
  review_score integer [not null]
  review_comment_title varchar
  review_comment_message text
  review_creation_date timestamp [not null]
  review_answer_timestamp timestamp

  indexes {
    (review_id, order_id) [pk]
  }
}

Table clean.orders {
  order_id varchar [primary key]
  customer_id varchar [not null]
  order_status varchar [not null]
  order_purchase_timestamp timestamp [not null]   
  order_approved_at timestamp
  order_delivered_carrier_date timestamp
  order_delivered_customer_date timestamp
  order_estimated_delivery_date timestamp [not null]
}

Table clean.products {
  product_id varchar [primary key, not null]
  product_category_name varchar
  product_name_lenght integer
  product_description_lenght integer
  product_photos_qty integer
  product_weight_g integer
  product_length_cm integer   
  product_height_cm integer
  product_width_cm integer
}

Table clean.sellers {
  seller_id varchar [primary key, not null]
  seller_zip_code_prefix integer [not null]
  seller_city varchar
  seller_state varchar
}

Table clean.product_category_name_translation {
  id integer [increment, primary key]
  product_category_name varchar [unique, not null]
  product_category_name_english varchar [not null]
}

Ref: clean.orders.customer_id > clean.customers.customer_id
Ref: clean.order_items.order_id > clean.orders.order_id
Ref: clean.order_items.product_id > clean.products.product_id
Ref: clean.order_items.seller_id > clean.sellers.seller_id
Ref: clean.order_payments.order_id > clean.orders.order_id
Ref: clean.order_reviews.order_id > clean.orders.order_id
Ref: clean.products.product_category_name > clean.product_category_name_translation.product_category_name
